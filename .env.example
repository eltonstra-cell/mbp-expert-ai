# Use esta variável somente no ambiente do servidor (por exemplo, Vercel).
# Nunca envie uma chave real ao GitHub.
NOVO_NEON_DATABASE_URL=
DATABASE_URL=

OPENAI_API_KEY=

# Opcional. Se omitida, a aplicação usa gpt-5.6-terra.
OPENAI_VISION_MODEL=gpt-5.6-terra

# Neon Managed Better Auth. Deixe ACCESS_CONTROL_MODE=preparation até o
# primeiro Administrador ser criado e o login ser validado em um Preview.
# A integração Vercel do banco novo cria esta variável automaticamente.
NOVO_NEON_NEON_AUTH_BASE_URL=
# Alternativa para instalações sem o prefixo do banco novo.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
ACCESS_CONTROL_MODE=preparation

# Modos: active | preparation | off. Na Vercel (production/preview), ausente = active;
# só "off" explícito desliga. Em desenvolvimento local, ausente = não aplica.
# (ACCESS_CONTROL_MODE já listada acima.)

# Token do Vercel Blob (criado pela integração Vercel; somente servidor).
BLOB_READ_WRITE_TOKEN=

# Libera DATABASE_URL (banco legado) na Vercel quando não há NOVO_NEON_*.
# Deixe vazio/ausente. Só use "true" de forma consciente e temporária.
ALLOW_LEGACY_DATABASE_URL=
